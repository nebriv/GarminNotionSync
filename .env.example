# ---------------------------------------------------------------------------
# Required secrets
# ---------------------------------------------------------------------------
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password
NOTION_TOKEN=secret_xxx
NOTION_DATABASE_ID=1e470776fe814d8c9a848ac1f24606b3

# ---------------------------------------------------------------------------
# Notifications (Apprise). Comma/space/newline-separated list of Apprise URLs.
# Leave empty to disable. Examples:
#   Discord: discord://webhook_id/webhook_token
#   Email:   mailto://user:pass@smtp.example.com?to=you@example.com
# Full list: https://github.com/caronc/apprise/wiki
# ---------------------------------------------------------------------------
APPRISE_URLS=
# When to send SUCCESS notifications: new (only when rows were created) | always | never
NOTIFY_ON_SUCCESS=new

# ---------------------------------------------------------------------------
# Scheduling / sync window (used by runner.py)
# ---------------------------------------------------------------------------
SYNC_INTERVAL_HOURS=12
SYNC_DAYS=2
RUN_ON_START=true
# Timezone for logs/scheduling (e.g. America/New_York). Defaults to UTC.
TZ=UTC

# ---------------------------------------------------------------------------
# Logging / observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# text (human-readable) | json (for Loki/ELK)
LOG_FORMAT=text
# HTTP port for /healthz /status /metrics. Set to 0 to disable the server.
METRICS_PORT=9100

# ---------------------------------------------------------------------------
# Advanced / optional
# ---------------------------------------------------------------------------
# Garmin typeKeys to sync (comma-separated). Default: hiking,running,trail_running
# TRACKED_TYPES=hiking,running,trail_running,cycling
# Pause between Notion writes to avoid rate limits (milliseconds).
# NOTION_PACING_MS=350
# Attach each new activity's FIT (decoded to JSON) and GPX (as .xml) files to Notion.
# Needs "Files & media" columns named below; auto-skipped if they don't exist.
# SYNC_ATTACHMENTS=true
# NOTION_FIT_PROPERTY=FIT File
# NOTION_GPX_PROPERTY=GPX File
# Skip attachments larger than this (Notion single-part upload limit, MB).
# NOTION_UPLOAD_MAX_MB=20

# Physiology metrics: compute decoupling, HR lag/recovery, cadence bands, scatter
# payloads, etc. from each activity's track. The full JSON record is attached to a
# "Metrics JSON" files column; headline scalars go to their own columns.
# SYNC_METRICS=true
# NOTION_METRICS_PROPERTY=Metrics JSON
# Auto-create any missing metric columns via the Notion API (set false to opt out).
# NOTION_CREATE_COLUMNS=true
# Max HR for the percent-of-max zone model.
# MAX_HR=190
# Skip metrics for very short tracks (e.g. no-GPS treadmill activities).
# METRICS_MIN_TRACKPOINTS=30
# Warn when the Garmin refresh token has fewer than this many days left.
# TOKEN_WARN_DAYS=21
# Where Garmin tokens are stored inside the container (mounted volume).
# GARMIN_TOKEN_DIR=/data/garmin-tokens
# One-time headless token seeding: a base64 garth token blob (alternative to
# the interactive `--login` bootstrap). Leave unset normally.
# GARMIN_TOKENS_BASE64=
